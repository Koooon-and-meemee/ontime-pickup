<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.automotive" android:required="true" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- NaviHelper: 경유지 추가/목적지 설정(ROUTE_SEARCH), 남은 시간 조회(ROUTE) -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.OnTimePickup"
        android:usesCleartextTraffic="true">

        <!-- 주문·매장 선택 화면. Distraction Optimization을 선언하지 않으므로 주차 중에만 열린다.
             주행 중 주문은 Gleo 음성(GleoReceiver)으로만 받는다. -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 주문 이후 ETA를 따라가며 서버에 올리는 서비스. 주행 중에도 화면 없이 동작한다. -->
        <service
            android:name=".PickupService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Gleo Interface: assets/schema.json 의 function 이름이 곧 intent action -->
        <receiver
            android:name=".GleoReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="ORDER_USUAL" />
                <action android:name="FIND_PICKUP_STORE" />
                <action android:name="CANCEL_PICKUP_ORDER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
